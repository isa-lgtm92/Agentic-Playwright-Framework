{
  "name": "playwright-ai-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript Playwright foundation for UI, API, and accessibility automation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:a11y": "playwright test tests/accessibility",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "validate:agents": "node scripts/validate-agents.mjs",
    "check": "npm run validate:agents && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
